import matplotlib
import matplotlib.pyplot as plt
import numpy as np
import librosa
import librosa.display
import soundfile as sf

# 1. 파일 로드 및 STFT 수행
clean, sr = sf.read('7021-79730-0000.wav')
noisy, _ = sf.read('noisy_signal_0dB.wav')

noisy_stft = librosa.stft(noisy)
noisy_mag, noisy_phase = librosa.magphase(noisy_stft)

# 2. 전력 스펙트럼(Power Spectrum) 계산 (|STFT|^2)
noisy_power = noisy_mag ** 2

# 3. 노이즈 전력 프로파일 추정 
# 앞 10개에 해당하는 시간구간의 주파수별 전력을 평균내고 위너필터 가중치를 계산하기 위해서 계산된 평균 전력을 전체시간 프레임 방향으로 복사 확장

noise_power_profile = np.mean(noisy_power[:, :10], axis=1, keepdims=True)

# 4. 위너 필터 가중치(Gain) 계산
# H = (P_Y - P_N) / P_Y = 1 - (P_N / P_Y)
# 해당 필터의 경우 관측된 신호를 분모에 두어서 signal이 noise에 비해 상대적으로 작으면 gain이 작아지고, signal이 noise에 비해 상대적으로 크면 gain이 커지게 둠
# Division by zero 방지를 위해 아주 작은 값(1e-10)을 더함
gain = 1.0 - (noise_power_profile / (noisy_power + 1e-10))

# 가중치가 음수가 되지 않도록 최소값(Floor) 처리 
min_gain = 0.01
gain = np.maximum(gain, min_gain)

# 5. 위너 필터 적용 (가중치 곱셈)
enhanced_mag = gain * noisy_mag
enhanced_stft = enhanced_mag * noisy_phase

# 6. 역 STFT로 복원 및 저장
enhanced_audio = librosa.istft(enhanced_stft)
sf.write('wiener_enhanced_speech1.wav', enhanced_audio, sr)
print("위너 필터링 완료! 'wiener_enhanced_speech1.wav' 저장 완료.")

# 7. 스펙트로그램 시각화 비교
clean_stft = librosa.stft(clean)
clean_db = librosa.amplitude_to_db(np.abs(clean_stft), ref=np.max)
noisy_db = librosa.amplitude_to_db(noisy_mag, ref=np.max)
enhanced_db = librosa.amplitude_to_db(enhanced_mag, ref=np.max)

plt.figure(figsize=(12, 10))
# 나이퀴스트 이론에 따라서 y축은 0~8000Hz까지 표시 (샘플링 주파수 16kHz 기준), x축은 시간축으로 표시
plt.subplot(3, 1, 1)
librosa.display.specshow(clean_db, sr=sr, x_axis='time', y_axis='hz')
plt.title('1. Clean Speech')

plt.subplot(3, 1, 2)
librosa.display.specshow(noisy_db, sr=sr, x_axis='time', y_axis='hz')
plt.title('2. Noisy Speech (0dB)')

plt.subplot(3, 1, 3)
librosa.display.specshow(enhanced_db, sr=sr, x_axis='time', y_axis='hz')
plt.title('3. Wiener Filtered Speech')

plt.tight_layout()
plt.show()

